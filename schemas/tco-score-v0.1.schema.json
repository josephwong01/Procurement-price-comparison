{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/josephwong01/Procurement-price-comparison/schemas/tco-score-v0.1.schema.json",
  "title":"TCO and Composite Score Schema v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","calculation_id","requirement_id","candidate_id","calculation_status","comparison_currency","exchange_rates","cost_components","known_cost_total_cny","estimated_tco_cny","unknown_costs","price_display","scoring","ranking","provenance"],
  "properties":{
    "schema_version":{"const":"0.1"},"calculation_id":{"$ref":"#/$defs/nonEmptyString"},"requirement_id":{"$ref":"#/$defs/nonEmptyString"},"candidate_id":{"$ref":"#/$defs/nonEmptyString"},
    "calculation_status":{"enum":["COMPLETE","PARTIAL","UNAVAILABLE","STALE"]},"comparison_currency":{"const":"CNY"},
    "exchange_rates":{"type":"array","items":{"$ref":"#/$defs/exchangeRate"}},"cost_components":{"type":"array","items":{"$ref":"#/$defs/costComponent"},"minItems":1},
    "known_cost_total_cny":{"type":["number","null"],"minimum":0},"estimated_tco_cny":{"type":["number","null"],"minimum":0},
    "unknown_costs":{"type":"array","items":{"$ref":"#/$defs/unknownCost"}},"price_display":{"$ref":"#/$defs/priceDisplay"},
    "scoring":{"$ref":"#/$defs/scoring"},"ranking":{"$ref":"#/$defs/ranking"},"provenance":{"$ref":"#/$defs/provenance"}
  },
  "$defs":{
    "nonEmptyString":{"type":"string","minLength":1},"nullableString":{"type":["string","null"]},"confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
    "money":{"type":"object","additionalProperties":false,"required":["amount","currency"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":"string","pattern":"^[A-Z]{3}$"}}},
    "exchangeRate":{"type":"object","additionalProperties":false,"required":["from_currency","to_currency","rate","rate_type","observed_at","source_note","confidence"],"properties":{"from_currency":{"type":"string","pattern":"^[A-Z]{3}$"},"to_currency":{"const":"CNY"},"rate":{"type":"number","exclusiveMinimum":0},"rate_type":{"enum":["APPROXIMATE_REFERENCE","FIXED_SCENARIO","ACTUAL_PAYMENT"]},"observed_at":{"type":"string","format":"date-time"},"source_note":{"$ref":"#/$defs/nonEmptyString"},"confidence":{"$ref":"#/$defs/confidence"}}},
    "costComponent":{"type":"object","additionalProperties":false,"required":["code","label","original_amount","converted_cny","included_in_tco","basis","confidence","evidence_refs"],"properties":{"code":{"enum":["ITEM_PRICE","DOMESTIC_FREIGHT","INTERNATIONAL_FREIGHT","TAX","DUTY","CUSTOMIZATION","SERVICE_FEE","INSTALLATION","CONSUMABLES","PAYMENT_FEE","OTHER"]},"label":{"$ref":"#/$defs/nonEmptyString"},"original_amount":{"$ref":"#/$defs/money"},"converted_cny":{"type":"number","minimum":0},"included_in_tco":{"type":"boolean"},"basis":{"enum":["LISTED","QUOTED","CALCULATED","ESTIMATED","ACTUAL"]},"confidence":{"$ref":"#/$defs/confidence"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"minItems":1,"uniqueItems":true}}},
    "unknownCost":{"type":"object","additionalProperties":false,"required":["code","description","materiality","blocking","treatment"],"properties":{"code":{"$ref":"#/$defs/nonEmptyString"},"description":{"$ref":"#/$defs/nonEmptyString"},"materiality":{"enum":["LOW","MEDIUM","HIGH","UNKNOWN"]},"blocking":{"type":"boolean"},"treatment":{"enum":["EXCLUDED_AND_FLAGGED","SCENARIO_ESTIMATE_PENDING","QUOTE_REQUIRED"]}}},
    "priceDisplay":{"type":"object","additionalProperties":false,"required":["display_text","cny_amount","original_amount","is_estimate","rounding_rule"],"properties":{"display_text":{"$ref":"#/$defs/nonEmptyString"},"cny_amount":{"type":["number","null"],"minimum":0},"original_amount":{"oneOf":[{"$ref":"#/$defs/money"},{"type":"null"}]},"is_estimate":{"type":"boolean"},"rounding_rule":{"enum":["NEAREST_YUAN","TWO_DECIMALS"]}}},
    "scoreDimension":{"type":"object","additionalProperties":false,"required":["code","score","weight","weighted_score","reason","confidence","evidence_refs"],"properties":{"code":{"enum":["PRODUCT_MATCH","PRICE","SUPPLIER","DELIVERY","QUALITY_RISK"]},"score":{"type":["number","null"],"minimum":0,"maximum":100},"weight":{"type":"number","minimum":0,"maximum":1},"weighted_score":{"type":["number","null"],"minimum":0,"maximum":100},"reason":{"$ref":"#/$defs/nonEmptyString"},"confidence":{"$ref":"#/$defs/confidence"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}}},
    "scoring":{"type":"object","additionalProperties":false,"required":["profile","dimensions","overall_score","score_status","score_explanation"],"properties":{"profile":{"enum":["BALANCED","COST_LEANING","QUALITY_LEANING","DELIVERY_LEANING","CUSTOM"]},"dimensions":{"type":"array","items":{"$ref":"#/$defs/scoreDimension"},"minItems":5,"maxItems":5},"overall_score":{"type":["number","null"],"minimum":0,"maximum":100},"score_status":{"enum":["NOT_SCORED","PROVISIONAL","FINAL"]},"score_explanation":{"$ref":"#/$defs/nonEmptyString"}}},
    "ranking":{"type":"object","additionalProperties":false,"required":["eligible","blocking_reasons","rank","recommendation_role"],"properties":{"eligible":{"type":"boolean"},"blocking_reasons":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true},"rank":{"type":["integer","null"],"minimum":1},"recommendation_role":{"enum":["PRIMARY","ALTERNATIVE","LOWEST_COST","PREMIUM","BACKUP","NONE"]}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["created_at","updated_at","created_by","model_version","overall_confidence","assumptions"],"properties":{"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"created_by":{"$ref":"#/$defs/nonEmptyString"},"model_version":{"$ref":"#/$defs/nonEmptyString"},"overall_confidence":{"$ref":"#/$defs/confidence"},"assumptions":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}}}
  }
}



