{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/josephwong01/Procurement-price-comparison/schemas/candidate-resolution-v0.1-candidate.schema.json",
  "title":"Candidate Match and Deduplication Schema v0.1 Candidate",
  "oneOf":[{"$ref":"#/$defs/matchRecord"},{"$ref":"#/$defs/duplicateCluster"}],
  "$defs":{
    "nonEmptyString":{"type":"string","minLength":1},"nullableString":{"type":["string","null"]},"confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
    "provenance":{"type":"object","additionalProperties":false,"required":["created_at","updated_at","created_by","engine_version","overall_confidence","assumptions"],"properties":{"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"created_by":{"$ref":"#/$defs/nonEmptyString"},"engine_version":{"$ref":"#/$defs/nonEmptyString"},"overall_confidence":{"$ref":"#/$defs/confidence"},"assumptions":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}}},
    "criterion":{"type":"object","additionalProperties":false,"required":["criterion_id","requirement_path","candidate_path","label","level","operator","expected_value","observed_value","result","confidence","reason","evidence_refs"],"properties":{"criterion_id":{"$ref":"#/$defs/nonEmptyString"},"requirement_path":{"$ref":"#/$defs/nonEmptyString"},"candidate_path":{"type":["string","null"]},"label":{"$ref":"#/$defs/nonEmptyString"},"level":{"enum":["HARD","PREFERENCE","INFO"]},"operator":{"enum":["EQ","NE","LT","LTE","GT","GTE","IN","CONTAINS","EXISTS","RANGE","SEMANTIC_MATCH","MANUAL"]},"expected_value":{},"observed_value":{},"result":{"enum":["PASS","FAIL","PARTIAL","UNKNOWN","NOT_APPLICABLE"]},"confidence":{"$ref":"#/$defs/confidence"},"reason":{"$ref":"#/$defs/nonEmptyString"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}}},
    "writeback":{"type":"object","additionalProperties":false,"required":["candidate_status","requirement_match_overall","exclusion_reasons"],"properties":{"candidate_status":{"enum":["PENDING_VALIDATION","ELIGIBLE","EXCLUDED"]},"requirement_match_overall":{"enum":["PASS","FAIL","PARTIAL","UNKNOWN"]},"exclusion_reasons":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}}},
    "matchRecord":{"type":"object","additionalProperties":false,"required":["schema_version","record_type","match_id","requirement_id","candidate_id","procurement_type","overall_result","hard_failure","criteria","missing_information","writeback","evidence_refs","provenance"],"properties":{"schema_version":{"const":"0.1-candidate"},"record_type":{"const":"MATCH_RECORD"},"match_id":{"$ref":"#/$defs/nonEmptyString"},"requirement_id":{"$ref":"#/$defs/nonEmptyString"},"candidate_id":{"$ref":"#/$defs/nonEmptyString"},"procurement_type":{"enum":["STANDARD_PRODUCT","EQUIPMENT","CUSTOM_PRODUCT","SERVICE"]},"overall_result":{"enum":["PASS","FAIL","PARTIAL","UNKNOWN"]},"hard_failure":{"type":"boolean"},"criteria":{"type":"array","items":{"$ref":"#/$defs/criterion"},"minItems":1},"missing_information":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true},"writeback":{"$ref":"#/$defs/writeback"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"minItems":1,"uniqueItems":true},"provenance":{"$ref":"#/$defs/provenance"}}},
    "fingerprint":{"type":"object","additionalProperties":false,"required":["brand","model","manufacturer_part_number","gtin","selected_sku","normalized_title","key_attributes"],"properties":{"brand":{"$ref":"#/$defs/nullableString"},"model":{"$ref":"#/$defs/nullableString"},"manufacturer_part_number":{"$ref":"#/$defs/nullableString"},"gtin":{"$ref":"#/$defs/nullableString"},"selected_sku":{"$ref":"#/$defs/nullableString"},"normalized_title":{"$ref":"#/$defs/nonEmptyString"},"key_attributes":{"type":"object"}}},
    "member":{"type":"object","additionalProperties":false,"required":["candidate_id","platform_code","supplier_id","product_url","fingerprint","member_role"],"properties":{"candidate_id":{"$ref":"#/$defs/nonEmptyString"},"platform_code":{"$ref":"#/$defs/nonEmptyString"},"supplier_id":{"$ref":"#/$defs/nullableString"},"product_url":{"type":"string","format":"uri"},"fingerprint":{"$ref":"#/$defs/fingerprint"},"member_role":{"enum":["CANONICAL","ALTERNATIVE_SOURCE","VARIANT","POSSIBLE_DUPLICATE"]}}},
    "relationship":{"type":"object","additionalProperties":false,"required":["left_candidate_id","right_candidate_id","relationship_type","confidence","matching_keys","conflicting_keys","reason","evidence_refs"],"properties":{"left_candidate_id":{"$ref":"#/$defs/nonEmptyString"},"right_candidate_id":{"$ref":"#/$defs/nonEmptyString"},"relationship_type":{"enum":["EXACT_DUPLICATE","SAME_PRODUCT_DIFFERENT_VARIANT","SAME_MODEL_DIFFERENT_OFFER","SAME_SUPPLIER_DIFFERENT_LISTING","POSSIBLE_DUPLICATE","NOT_DUPLICATE"]},"confidence":{"$ref":"#/$defs/confidence"},"matching_keys":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true},"conflicting_keys":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true},"reason":{"$ref":"#/$defs/nonEmptyString"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}}},
    "duplicateCluster":{"type":"object","additionalProperties":false,"required":["schema_version","record_type","cluster_id","requirement_id","canonical_candidate_id","canonical_selection_basis","members","relationships","resolution","rationale","evidence_refs","provenance"],"properties":{"schema_version":{"const":"0.1-candidate"},"record_type":{"const":"DUPLICATE_CLUSTER"},"cluster_id":{"$ref":"#/$defs/nonEmptyString"},"requirement_id":{"$ref":"#/$defs/nonEmptyString"},"canonical_candidate_id":{"$ref":"#/$defs/nonEmptyString"},"canonical_selection_basis":{"type":"array","items":{"enum":["LOCKED_SKU","COMPLETE_PRICE","EVIDENCE_QUALITY","FRESHNESS","SUPPLIER_CLARITY","DIRECT_URL"]},"minItems":1,"uniqueItems":true},"members":{"type":"array","items":{"$ref":"#/$defs/member"},"minItems":2},"relationships":{"type":"array","items":{"$ref":"#/$defs/relationship"},"minItems":1},"resolution":{"enum":["KEEP_ALL_LINKED","MERGE_EXACT_DUPLICATES","HUMAN_REVIEW"]},"rationale":{"$ref":"#/$defs/nonEmptyString"},"evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"minItems":1,"uniqueItems":true},"provenance":{"$ref":"#/$defs/provenance"}}}
  }
}

