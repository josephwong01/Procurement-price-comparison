{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/josephwong01/Procurement-price-comparison/schemas/query-plan-v0.1.schema.json",
  "title":"Query Plan Schema v0.1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","plan_id","requirement_id","procurement_type","plan_status","planning_context","platform_tasks","discovery_policy","stop_conditions","fallback_rules","provenance"],
  "properties":{
    "schema_version":{"const":"0.1"},
    "plan_id":{"$ref":"#/$defs/nonEmptyString"},
    "requirement_id":{"$ref":"#/$defs/nonEmptyString"},
    "procurement_type":{"enum":["STANDARD_PRODUCT","EQUIPMENT","CUSTOM_PRODUCT","SERVICE"]},
    "plan_status":{"enum":["DRAFT","READY","PARTIALLY_EXECUTABLE","BLOCKED","COMPLETED","STALE"]},
    "planning_context":{"$ref":"#/$defs/planningContext"},
    "platform_tasks":{"type":"array","items":{"$ref":"#/$defs/platformTask"},"minItems":1},
    "discovery_policy":{"$ref":"#/$defs/discoveryPolicy"},
    "stop_conditions":{"$ref":"#/$defs/stopConditions"},
    "fallback_rules":{"type":"array","items":{"$ref":"#/$defs/fallbackRule"}},
    "provenance":{"$ref":"#/$defs/provenance"}
  },
  "$defs":{
    "nonEmptyString":{"type":"string","minLength":1},
    "nullableString":{"type":["string","null"]},
    "confidence":{"enum":["HIGH","MEDIUM","LOW","UNVERIFIED"]},
    "planningContext":{"type":"object","additionalProperties":false,"required":["requirement_status","blocking_questions","warnings","assumptions","input_schema_version"],"properties":{
      "requirement_status":{"enum":["DRAFT","NEEDS_CLARIFICATION","SEARCH_READY","COMPARISON_READY","RFQ_READY"]},
      "blocking_questions":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"maxItems":3},
      "warnings":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
      "assumptions":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
      "input_schema_version":{"$ref":"#/$defs/nonEmptyString"}
    }},
    "platformTarget":{"type":"object","additionalProperties":false,"required":["platform_id","platform_name","market","channel_type","base_url"],"properties":{
      "platform_id":{"$ref":"#/$defs/nonEmptyString"},"platform_name":{"$ref":"#/$defs/nonEmptyString"},
      "market":{"type":["string","null"]},
      "channel_type":{"enum":["MARKETPLACE","RETAILER","PRICE_COMPARISON","SUPPLIER_DIRECTORY","MANUFACTURER_STORE","SERVICE_PLATFORM","SEARCH_ENGINE","OTHER"]},
      "base_url":{"oneOf":[{"type":"string","format":"uri"},{"type":"null"}]}
    }},
    "searchQuery":{"type":"object","additionalProperties":false,"required":["query_id","text","language","purpose","breadth","negative_terms"],"properties":{
      "query_id":{"$ref":"#/$defs/nonEmptyString"},"text":{"$ref":"#/$defs/nonEmptyString"},"language":{"$ref":"#/$defs/nonEmptyString"},
      "purpose":{"enum":["CORE_PRODUCT","ATTRIBUTE_VARIANT","USE_CASE","SUPPLIER_DISCOVERY","PRICE_BOUND","COMPLIANCE","ALTERNATIVE_TERM"]},
      "breadth":{"enum":["BROAD","BALANCED","PRECISE"]},
      "negative_terms":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}
    }},
    "filter":{"type":"object","additionalProperties":false,"required":["filter_id","field","operator","value","level","application","reason"],"properties":{
      "filter_id":{"$ref":"#/$defs/nonEmptyString"},"field":{"$ref":"#/$defs/nonEmptyString"},
      "operator":{"enum":["EQ","NE","LT","LTE","GT","GTE","IN","CONTAINS","EXISTS","RANGE"]},"value":{},
      "level":{"enum":["HARD","PREFERENCE","INFO"]},
      "application":{"enum":["PLATFORM_NATIVE","QUERY_TERM","POST_FILTER","MANUAL_REVIEW"]},
      "reason":{"$ref":"#/$defs/nonEmptyString"}
    }},
    "accessStrategy":{"type":"object","additionalProperties":false,"required":["primary_method","allowed_fallback_methods","authentication_expected","notes"],"properties":{
      "primary_method":{"enum":["API","PUBLIC_WEB","BROWSER","SCREENSHOT","MANUAL"]},
      "allowed_fallback_methods":{"type":"array","items":{"enum":["API","PUBLIC_WEB","BROWSER","SCREENSHOT","MANUAL"]},"uniqueItems":true},
      "authentication_expected":{"type":"boolean"},"notes":{"$ref":"#/$defs/nullableString"}
    }},
    "platformTask":{"type":"object","additionalProperties":false,"required":["task_id","target","scope_role","priority","search_language","access_strategy","queries","filters","result_target","execution_status","execution_result","skip_reason"],"properties":{
      "task_id":{"$ref":"#/$defs/nonEmptyString"},"target":{"$ref":"#/$defs/platformTarget"},
      "scope_role":{"enum":["MUST_SEARCH","PREFERRED","SUPPLEMENTAL_DISCOVERY"]},"priority":{"type":"integer","minimum":1},
      "search_language":{"$ref":"#/$defs/nonEmptyString"},"access_strategy":{"$ref":"#/$defs/accessStrategy"},
      "queries":{"type":"array","items":{"$ref":"#/$defs/searchQuery"},"minItems":1},
      "filters":{"type":"array","items":{"$ref":"#/$defs/filter"}},
      "result_target":{"type":"object","additionalProperties":false,"required":["min_candidates","max_candidates"],"properties":{"min_candidates":{"type":"integer","minimum":0},"max_candidates":{"type":"integer","minimum":1}}},
      "execution_status":{"enum":["PENDING","RUNNING","COMPLETED","PARTIAL","FAILED","SKIPPED"]},
      "execution_result":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/executionResult"}]},
      "skip_reason":{"$ref":"#/$defs/nullableString"}
    }},
    "executionResult":{"type":"object","additionalProperties":false,"required":["attempted_at","search_result_count","detail_record_count","outcome_notes","evidence_refs"],"properties":{
      "attempted_at":{"type":"string","format":"date-time"},
      "search_result_count":{"type":"integer","minimum":0},"detail_record_count":{"type":"integer","minimum":0},
      "outcome_notes":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"}},
      "evidence_refs":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"minItems":1,"uniqueItems":true}
    }},
    "discoveryPolicy":{"type":"object","additionalProperties":false,"required":["enabled","min_platforms","max_platforms","selection_criteria","selected_platform_ids"],"properties":{
      "enabled":{"type":"boolean"},"min_platforms":{"type":"integer","minimum":0,"maximum":3},"max_platforms":{"type":"integer","minimum":0,"maximum":3},
      "selection_criteria":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true},
      "selected_platform_ids":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}
    }},
    "stopConditions":{"type":"object","additionalProperties":false,"required":["minimum_eligible_candidates","minimum_price_levels","all_must_search_attempted","stop_on_budget_exhaustion","maximum_queries"],"properties":{
      "minimum_eligible_candidates":{"type":"integer","minimum":1},"minimum_price_levels":{"type":"integer","minimum":1},
      "all_must_search_attempted":{"type":"boolean"},"stop_on_budget_exhaustion":{"type":"boolean"},"maximum_queries":{"type":"integer","minimum":1}
    }},
    "fallbackRule":{"type":"object","additionalProperties":false,"required":["rule_id","trigger","action","target_task_id","notes"],"properties":{
      "rule_id":{"$ref":"#/$defs/nonEmptyString"},"trigger":{"enum":["ACCESS_BLOCKED","NO_RESULTS","INSUFFICIENT_RESULTS","AUTH_REQUIRED","DATA_INCOMPLETE","PLATFORM_UNAVAILABLE"]},
      "action":{"enum":["CHANGE_QUERY","CHANGE_ACCESS_METHOD","USE_SEARCH_ENGINE_DISCOVERY","ADD_PLATFORM","DEFER_MANUAL_REVIEW","SKIP_WITH_REASON"]},
      "target_task_id":{"type":["string","null"]},"notes":{"$ref":"#/$defs/nonEmptyString"}
    }},
    "provenance":{"type":"object","additionalProperties":false,"required":["created_at","updated_at","created_by","planner_version","overall_confidence","assumptions"],"properties":{
      "created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"created_by":{"$ref":"#/$defs/nonEmptyString"},
      "planner_version":{"$ref":"#/$defs/nonEmptyString"},"overall_confidence":{"$ref":"#/$defs/confidence"},"assumptions":{"type":"array","items":{"$ref":"#/$defs/nonEmptyString"},"uniqueItems":true}
    }}
  }
}



