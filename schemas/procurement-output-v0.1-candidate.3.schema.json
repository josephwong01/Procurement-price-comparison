{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/josephwong01/Procurement-price-comparison/schemas/procurement-output-v0.1-candidate.3.schema.json",
  "title": "Procurement Output v0.1 Candidate.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_version", "report_id", "generated_at", "requirement_reference", "report_status", "coverage", "executive_summary", "comparison_basis", "scoring_model", "main_comparison_table", "candidate_details", "excluded_candidates", "risks", "confirmations", "evidence", "audit"],
  "properties": {
    "output_version": { "const": "0.1-candidate.3" },
    "report_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "data_cutoff_at": { "type": ["string", "null"], "format": "date-time" },
    "requirement_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "schema_version", "snapshot_reference"],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "string", "minLength": 1 },
        "snapshot_reference": { "type": ["string", "null"] }
      }
    },
    "report_status": { "enum": ["INCOMPLETE", "READY_FOR_REVIEW", "READY_FOR_APPROVAL", "FINAL"] },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["channels_attempted", "channels_succeeded", "candidates_found", "candidates_eligible", "candidates_excluded", "duplicates_removed", "limitations"],
      "properties": {
        "channels_attempted": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "channels_succeeded": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "candidates_found": { "type": "integer", "minimum": 0 },
        "candidates_eligible": { "type": "integer", "minimum": 0 },
        "candidates_excluded": { "type": "integer", "minimum": 0 },
        "duplicates_removed": { "type": "integer", "minimum": 0 },
        "limitations": { "type": "array", "items": { "$ref": "#/$defs/limitation" } }
      }
    },
    "executive_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_status", "summary", "recommended_candidate_ids", "recommendation_rationale", "scenario_picks", "current_tendency"],
      "properties": {
        "decision_status": { "enum": ["NO_RECOMMENDATION", "SHORTLIST_ONLY", "RECOMMENDED"] },
        "summary": { "type": "string", "minLength": 1 },
        "recommended_candidate_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "recommendation_rationale": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "current_tendency": { "enum": ["BALANCED", "PRICE_LEANING", "QUALITY_LEANING", "DELIVERY_LEANING", "SUPPLIER_LEANING", "CUSTOM"] },
        "scenario_picks": {
          "type": "object", "additionalProperties": false,
          "required": ["lowest_cost", "balanced", "highest_configuration"],
          "properties": {
            "lowest_cost": { "type": ["string", "null"] },
            "balanced": { "type": ["string", "null"] },
            "highest_configuration": { "type": ["string", "null"] }
          }
        }
      }
    },
    "comparison_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison_currency", "procurement_quantity", "fulfillment_option_id", "cost_basis", "unknown_cost_policy", "exchange_rates"],
      "properties": {
        "comparison_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "procurement_quantity": { "$ref": "common.schema.json#/$defs/quantity" },
        "fulfillment_option_id": { "type": ["string", "null"] },
        "cost_basis": { "enum": ["DISPLAY_PRICE", "TAX_INCLUDED_PRICE", "DELIVERED_PRICE", "LANDED_COST", "ALL_IN_SERVICE_FEE"] },
        "unknown_cost_policy": { "const": "DO_NOT_TREAT_AS_ZERO" },
        "exchange_rates": { "type": "array", "items": { "$ref": "#/$defs/exchangeRate" } }
      }
    },
    "scoring_model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_name", "dimensions", "score_scale", "calculation_note"],
      "properties": {
        "model_name": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "array", "minItems": 4, "maxItems": 5, "items": { "$ref": "#/$defs/scoringDimension" } },
        "score_scale": { "const": "0-100" },
        "calculation_note": { "type": "string", "minLength": 1 }
      }
    },
    "main_comparison_table": { "type": "array", "items": { "$ref": "#/$defs/mainComparisonRow" } },
    "candidate_details": { "type": "array", "items": { "$ref": "#/$defs/candidateDetail" } },
    "excluded_candidates": { "type": "array", "items": { "$ref": "#/$defs/excludedCandidate" } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "confirmations": { "type": "array", "items": { "$ref": "#/$defs/confirmation" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["generated_by", "method_version", "assumptions"],
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "report_status": { "enum": ["READY_FOR_REVIEW", "READY_FOR_APPROVAL", "FINAL"] } }, "required": ["report_status"] },
      "then": { "properties": { "main_comparison_table": { "minItems": 1 }, "candidate_details": { "minItems": 1 }, "evidence": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "report_status": { "enum": ["READY_FOR_APPROVAL", "FINAL"] } }, "required": ["report_status"] },
      "then": {
        "properties": {
          "confirmations": {
            "not": { "contains": { "type": "object", "properties": { "blocking": { "const": true }, "status": { "const": "OPEN" } }, "required": ["blocking", "status"] } }
          },
          "executive_summary": {
            "properties": {
              "decision_status": { "const": "RECOMMENDED" },
              "recommended_candidate_ids": { "minItems": 1 },
              "recommendation_rationale": { "minItems": 1 }
            }
          },
          "main_comparison_table": {
            "minItems": 1,
            "items": {
              "properties": {
                "overall_score": { "type": "number" },
                "price": { "properties": { "normalized_total_cost": { "$ref": "common.schema.json#/$defs/money" } } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "executive_summary": { "properties": { "decision_status": { "const": "RECOMMENDED" } }, "required": ["decision_status"] } } },
      "then": { "properties": { "executive_summary": { "properties": { "recommended_candidate_ids": { "minItems": 1 }, "recommendation_rationale": { "minItems": 1 } } } } }
    }
  ],
  "$defs": {
    "limitation": {
      "type": "object", "additionalProperties": false, "required": ["code", "description", "impact"],
      "properties": {
        "code": { "enum": ["LOGIN_REQUIRED", "DATA_UNAVAILABLE", "PRICE_REQUIRES_INQUIRY", "MANUAL_CONFIRMATION_REQUIRED", "CHANNEL_FAILED", "OTHER"] },
        "description": { "type": "string", "minLength": 1 }, "impact": { "enum": ["LOW", "MEDIUM", "HIGH"] }
      }
    },
    "exchangeRate": {
      "type": "object", "additionalProperties": false, "required": ["from_currency", "to_currency", "rate", "observed_at", "source"],
      "properties": {
        "from_currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "to_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "rate": { "type": "number", "exclusiveMinimum": 0 }, "observed_at": { "type": "string", "format": "date-time" }, "source": { "type": "string", "minLength": 1 }
      }
    },
    "scoringDimension": {
      "type": "object", "additionalProperties": false, "required": ["code", "name", "weight", "description"],
      "properties": {
        "code": { "enum": ["PRODUCT_MATCH", "PRICE", "SUPPLIER", "DELIVERY", "QUALITY_RISK", "CUSTOM"] },
        "name": { "type": "string", "minLength": 1 }, "weight": { "type": "number", "minimum": 0, "maximum": 1 }, "description": { "type": "string", "minLength": 1 }
      }
    },
    "ratingSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "score", "scale_max", "count", "source", "observed_at"],
      "properties": {
        "subject": { "enum": ["SUPPLIER", "STORE"] },
        "score": { "type": "number", "minimum": 0 },
        "scale_max": { "type": "number", "exclusiveMinimum": 0 },
        "count": { "type": ["integer", "null"], "minimum": 0 },
        "source": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "scoreBreakdown": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension_code", "raw_score", "weight", "weighted_score", "rationale"],
      "properties": {
        "dimension_code": { "enum": ["PRODUCT_MATCH", "PRICE", "SUPPLIER", "DELIVERY", "QUALITY_RISK", "CUSTOM"] },
        "raw_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "weighted_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "mainComparisonRow": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "candidate_id", "platform", "product_title", "product_url", "supplier_name", "price", "advantages", "disadvantages", "supplier_rating", "supplier_signal", "overall_score", "recommendation_role", "detail_ref"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 }, "candidate_id": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }, "product_title": { "type": "string", "minLength": 1 }, "product_url": { "type": "string", "format": "uri" }, "supplier_name": { "type": ["string", "null"] },
        "price": { "$ref": "#/$defs/priceSummary" },
        "advantages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "disadvantages": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "supplier_rating": { "oneOf": [{ "$ref": "#/$defs/ratingSummary" }, { "type": "null" }] },
        "supplier_signal": { "type": ["string", "null"] },
        "overall_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "recommendation_role": { "enum": ["LOWEST_COST", "BALANCED", "HIGHEST_CONFIGURATION", "SHORTLIST", "NONE"] },
        "detail_ref": { "type": "string", "minLength": 1 }
      }
    },
    "priceSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["display_unit_price", "normalized_total_cost", "cost_basis", "unknown_costs", "confidence"],
      "properties": {
        "display_unit_price": { "oneOf": [{ "$ref": "common.schema.json#/$defs/money" }, { "type": "null" }] },
        "normalized_total_cost": { "oneOf": [{ "$ref": "common.schema.json#/$defs/money" }, { "type": "null" }] },
        "cost_basis": { "enum": ["DISPLAY_PRICE", "TAX_INCLUDED_PRICE", "DELIVERED_PRICE", "LANDED_COST", "ALL_IN_SERVICE_FEE"] },
        "unknown_costs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }
      }
    },
    "candidateDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["detail_id", "candidate_id", "supplier_id", "product_url", "eligibility", "specification_summary", "commercial", "supplier_snapshot", "score_breakdown", "score_explanation", "evidence_refs", "risk_refs"],
      "properties": {
        "detail_id": { "type": "string", "minLength": 1 }, "candidate_id": { "type": "string", "minLength": 1 }, "supplier_id": { "type": ["string", "null"] },
        "product_url": { "type": "string", "format": "uri" }, "eligibility": { "enum": ["ELIGIBLE", "CONDITIONAL"] },
        "specification_summary": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "commercial": { "$ref": "#/$defs/commercial" }, "supplier_snapshot": { "$ref": "#/$defs/supplierSnapshot" },
        "score_breakdown": { "type": "array", "minItems": 4, "maxItems": 5, "items": { "$ref": "#/$defs/scoreBreakdown" } },
        "score_explanation": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "risk_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "excludedCandidate": {
      "type": "object", "additionalProperties": false, "required": ["candidate_id", "platform", "product_title", "product_url", "exclusion_reasons", "evidence_refs"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 }, "platform": { "type": "string", "minLength": 1 }, "product_title": { "type": "string", "minLength": 1 },
        "product_url": { "type": "string", "format": "uri" }, "exclusion_reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false, "required": ["name", "value", "status"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "value": {}, "status": { "enum": ["CONFIRMED", "CLAIMED", "UNKNOWN", "NOT_APPLICABLE"] } }
    },
    "commercial": {
      "type": "object", "additionalProperties": false, "required": ["moq", "lead_time_days", "invoice", "payment_terms", "known_costs"],
      "properties": {
        "moq": { "oneOf": [{ "$ref": "common.schema.json#/$defs/quantity" }, { "type": "null" }] }, "lead_time_days": { "type": ["integer", "null"], "minimum": 0 },
        "invoice": { "type": ["string", "null"] }, "payment_terms": { "type": ["string", "null"] }, "known_costs": { "type": "array", "items": { "$ref": "#/$defs/costLine" } }
      }
    },
    "costLine": {
      "type": "object", "additionalProperties": false, "required": ["component", "amount"],
      "properties": {
        "component": { "enum": ["ITEM_PRICE", "DOMESTIC_FREIGHT", "INTERNATIONAL_FREIGHT", "TAX", "CUSTOMIZATION", "PACKAGING", "SAMPLE", "MOLD", "PAYMENT_FEE", "INSTALLATION", "SERVICE_FEE", "OTHER"] },
        "amount": { "$ref": "common.schema.json#/$defs/money" }, "notes": { "type": ["string", "null"] }
      }
    },
    "supplierSnapshot": {
      "type": "object", "additionalProperties": false, "required": ["supplier_type", "location", "rating", "rating_count", "transaction_signal", "certifications"],
      "properties": {
        "supplier_type": { "enum": ["FACTORY", "TRADER", "RETAILER", "SERVICE_PROVIDER", "INDIVIDUAL", "UNKNOWN"] }, "location": { "type": ["string", "null"] },
        "rating": { "type": ["number", "null"], "minimum": 0, "maximum": 5 }, "rating_count": { "type": ["integer", "null"], "minimum": 0 },
        "transaction_signal": { "type": ["string", "null"] }, "certifications": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "risk": {
      "type": "object", "additionalProperties": false, "required": ["risk_id", "candidate_id", "category", "severity", "description", "mitigation", "status"],
      "properties": {
        "risk_id": { "type": "string", "minLength": 1 }, "candidate_id": { "type": ["string", "null"] },
        "category": { "enum": ["SPECIFICATION", "PRICE", "SUPPLIER", "DELIVERY", "COMPLIANCE", "QUALITY", "DATA_QUALITY", "OTHER"] },
        "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }, "description": { "type": "string", "minLength": 1 }, "mitigation": { "type": ["string", "null"] },
        "status": { "enum": ["OPEN", "MITIGATED", "ACCEPTED", "CLOSED"] }
      }
    },
    "confirmation": {
      "type": "object", "additionalProperties": false, "required": ["confirmation_id", "candidate_id", "question", "owner", "blocking", "status"],
      "properties": {
        "confirmation_id": { "type": "string", "minLength": 1 }, "candidate_id": { "type": ["string", "null"] }, "question": { "type": "string", "minLength": 1 },
        "owner": { "enum": ["BUYER", "SUPPLIER", "AGENT", "THIRD_PARTY"] }, "blocking": { "type": "boolean" }, "status": { "enum": ["OPEN", "ANSWERED", "NOT_APPLICABLE"] },
        "answer": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["evidence_id", "candidate_id", "field_path", "source_url", "observed_at", "source_type", "original_value", "confidence"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 }, "candidate_id": { "type": ["string", "null"] }, "field_path": { "type": "string", "pattern": "^/" },
        "source_url": { "type": "string", "format": "uri" }, "observed_at": { "type": "string", "format": "date-time" },
        "source_type": { "enum": ["PRODUCT_PAGE", "SUPPLIER_PAGE", "SEARCH_RESULT", "DOCUMENT", "HUMAN_CONFIRMATION"] }, "original_value": {}, "normalized_value": {},
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" }, "capture_reference": { "type": ["string", "null"] }
      }
    }
  }
}



