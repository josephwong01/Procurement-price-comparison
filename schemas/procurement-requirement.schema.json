{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/josephwong01/Procurement-price-comparison/schemas/procurement-requirement.schema.json",
  "title": "Procurement Requirement",
  "description": "Normalized enterprise procurement requirement for sourcing, comparison, and RFQ readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "requirement_id", "status", "product", "quantity", "constraints", "readiness", "provenance"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "requirement_id": { "type": "string", "minLength": 1 },
    "title": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["DRAFT", "NEEDS_CLARIFICATION", "SEARCH_READY", "COMPARISON_READY", "RFQ_READY"]
    },
    "requester": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "department": { "type": ["string", "null"] },
        "company": { "type": ["string", "null"] }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "description", "attributes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "brand_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "type": "string", "enum": ["REQUIRED", "PREFERRED", "ANY", "UNKNOWN"] },
            "brands": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "substitutes_allowed": { "type": ["boolean", "null"] }
          }
        },
        "attributes": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributeConstraint" }
        }
      }
    },
    "quantity": { "$ref": "common.schema.json#/$defs/quantity" },
    "budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "unit_price_ceiling": { "oneOf": [{ "$ref": "common.schema.json#/$defs/money" }, { "type": "null" }] },
        "total_ceiling": { "oneOf": [{ "$ref": "common.schema.json#/$defs/money" }, { "type": "null" }] },
        "level": { "$ref": "common.schema.json#/$defs/constraintLevel" }
      }
    },
    "delivery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "destination": { "type": ["string", "null"] },
        "required_date": { "type": ["string", "null"], "format": "date" },
        "lead_time_days_max": { "type": ["integer", "null"], "minimum": 0 },
        "level": { "$ref": "common.schema.json#/$defs/constraintLevel" }
      }
    },
    "commercial": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "moq_max": { "oneOf": [{ "$ref": "common.schema.json#/$defs/quantity" }, { "type": "null" }] },
        "invoice_required": { "type": ["boolean", "null"] },
        "invoice_type": { "type": ["string", "null"] },
        "tax_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "payment_terms": { "type": ["string", "null"] }
      }
    },
    "customization": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["required", "requirements"],
      "properties": {
        "required": { "type": "boolean" },
        "process_confirmed": { "type": ["boolean", "null"] },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/attributeConstraint" }
        },
        "sample_required": { "type": ["boolean", "null"] },
        "artwork_reference": { "type": ["string", "null"] }
      }
    },
    "supplier_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/attributeConstraint" }
    },
    "search_preferences": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "platforms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "supplier_count_min": { "type": ["integer", "null"], "minimum": 1 },
        "languages": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true }
      }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/attributeConstraint" }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_questions", "warnings"],
      "properties": {
        "blocking_questions": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/provenanceEntry" }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "attributeConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "level", "operator", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] },
        "level": { "$ref": "common.schema.json#/$defs/constraintLevel" },
        "operator": {
          "type": "string",
          "enum": ["EQ", "NE", "GT", "GTE", "LT", "LTE", "IN", "NOT_IN", "CONTAINS", "EXISTS", "RANGE"]
        },
        "value": {},
        "unit": { "type": ["string", "null"] },
        "tolerance": { "type": ["number", "null"], "minimum": 0 },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
